rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Admin Rules ---
    // A function to check if the user's UID exists in the 'admins' collection.
    // This is the definitive way to identify an administrator.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Rule: Admins are granted full read and write access to the entire database.
    // This single rule ensures that any admin can perform any action needed for the dashboard.
    match /{path=**} {
      allow read, write: if isAdmin();
    }

    // --- Student & Public Rules ---

    // Rule: An authenticated student can only read their own document. They cannot see other students.
    // This rule is now secondary to the admin rule. An admin will match the rule above first.
    match /students/{studentId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      // Note: Write/update access for students to their own data is not granted here.
      // This would typically be handled by more specific rules if students need to edit their profile.
    }
    
    // Rule: An authenticated user can create a device registration request for themselves.
    match /pendingDevices/{docId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
    }

    // Rule: An authenticated student can read their own registered devices.
    // This is necessary for the app to check if the current device is approved.
    match /registeredDevices/{docId} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/registeredDevices/$(docId)) && resource.data.studentId == request.auth.uid;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Admin Rule ---
    // Admins can do anything, anywhere.
    // We check for a custom claim 'admin' on the user's auth token.
    match /{path=**} {
      allow read, write, list, delete: if request.auth.claims.admin == true;
    }

    // --- Student-specific Rules ---
    // These rules apply if the user is NOT an admin.

    // A student can read their own document.
    match /students/{studentId} {
      allow read: if request.auth.uid == studentId;
    }

    // Any authenticated user can create a device registration request for themselves.
    match /pendingDevices/{docId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
    }

    // A student can read their own registered devices.
    match /registeredDevices/{docId} {
      allow read: if request.auth != null && resource.data.studentId == request.auth.uid;
    }
  }
}

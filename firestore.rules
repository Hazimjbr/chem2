
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A function to check if the user is an admin.
    // It checks if a document with the user's UID exists in the 'admins' collection.
    function isAdmin() {
      // This is the function that is likely failing.
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- TEMPORARY DEBUGGING RULE ---
    // This rule is temporarily set to 'true' to test if the isAdmin() function is the issue.
    // This is NOT secure for production.
    match /students/{studentId} {
      allow read, list, write, delete: if true;
    }
    
    // --- Default secure rules for other collections ---
    
    // Any authenticated user can create a device registration request for themselves.
    match /pendingDevices/{docId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      // Admins can read and delete pending requests
      allow read, delete: if isAdmin();
    }

    // A student can read their own registered devices. Admins can read all.
    match /registeredDevices/{docId} {
      allow read: if (request.auth != null && resource.data.studentId == request.auth.uid) || isAdmin();
    }

    // Admins collection is locked down. Only readable by admins.
    match /admins/{adminId} {
        allow read: if isAdmin();
    }
  }
}

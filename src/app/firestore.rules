
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Admin Function ---
    // Checks if a document with the user's UID exists in the 'admins' collection.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Global Admin Rule ---
    // This rule grants full read and write access to the entire database for any user
    // identified as an admin by the isAdmin() function. This is the key to fixing the admin panel.
    match /{path=**} {
      allow read, write: if isAdmin();
    }

    // --- Student-specific Rules ---
    // These rules apply only if the user is NOT an admin.

    // A student can read their own document in the 'students' collection.
    match /students/{studentId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
    }

    // An authenticated user can create a device registration request for themselves.
    // This allows students to request new devices.
    match /pendingDevices/{docId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
    }

    // A student can read their own registered devices. This is necessary for the app to function.
    match /registeredDevices/{docId} {
      allow read: if request.auth != null && resource.data.studentId == request.auth.uid;
    }
  }
}
